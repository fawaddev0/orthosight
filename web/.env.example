# Optional for local Vite development. Defaults to http://127.0.0.1:8000.
ORTHOSIGHT_BACKEND_URL=http://127.0.0.1:8000

# Leave unset for the single-domain Vercel deployment. /api is routed by vercel.json.
# Set this only when serving the web app and API from separate origins.
# VITE_API_BASE_URL=https://your-backend-domain
